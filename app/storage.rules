rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasActiveSubscription() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.subscriptionStatus in ['active', 'trial'];
    }

    // Documents des appels : lecture par un compte avec abonnement ou essai. Écriture et suppression refusées depuis
    // l'application (regles-stockage-durcies, 2026-11-16) : tout compte en essai pouvait écrire et tout compte connecté
    // supprimer ; seul l'import (SDK administrateur, hors règles) dépose ces fichiers. Le dépôt par un financeur sera
    // conçu avec l'ouverture du stockage (facturation).
    match /uploads/aap-documents/{aapId}/{filename} {
      allow read: if isAuthenticated() && hasActiveSubscription();
      allow write, delete: if false;
    }

    // Pièces d'une candidature, déposées par le candidat avant la création du dossier (2026-10-20 : le formulaire
    // écrivait dans ce dossier sans règle, d'où « storage/unauthorized ») ; lecture et écriture par le propriétaire du
    // dossier seulement depuis le 2026-11-13 (question 20 : tout compte connecté pouvait lire les pièces d'un autre).
    // L'accès du financeur destinataire sera à concevoir avec l'ouverture du stockage (facturation).
    match /uploads/applications/{userId}/{filename} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Ancien dossier uploads/application-documents : règle retirée le 2026-11-16 (regles-stockage-durcies), aucun code ne
    // l'utilisait et tout compte connecté y lisait et supprimait ; un chemin sans règle est refusé.

    // Financeur logos
    match /uploads/logos/financeurs/{financeurId}/{filename} {
      allow read: if true; // Public
      allow write: if isOwner(financeurId);
      allow delete: if isOwner(financeurId);
    }

    // Profile avatars
    match /uploads/profiles/avatars/{userId}/{filename} {
      allow read: if true; // Public
      allow write: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}
