rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper function
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function hasActiveSubscription() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.subscriptionStatus in ['active', 'trial'];
    }

    // AAP documents
    match /uploads/aap-documents/{aapId}/{filename} {
      allow read: if isAuthenticated() && hasActiveSubscription();
      allow write: if isAuthenticated() && hasActiveSubscription();
      allow delete: if isAuthenticated();
    }

    // Pièces d'une candidature, déposées par le candidat avant la création du dossier (2026-10-20 : le formulaire
    // écrivait dans ce dossier sans règle, d'où « storage/unauthorized ») ; lecture par tout compte connecté (le
    // financeur destinataire), écriture par le propriétaire du dossier
    match /uploads/applications/{userId}/{filename} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Application documents
    match /uploads/application-documents/{applicationId}/{filename} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && hasActiveSubscription();
      allow delete: if isAuthenticated();
    }

    // Financeur logos
    match /uploads/logos/financeurs/{financeurId}/{filename} {
      allow read: if true; // Public
      allow write: if isOwner(financeurId);
      allow delete: if isOwner(financeurId);
    }

    // Profile avatars
    match /uploads/profiles/avatars/{userId}/{filename} {
      allow read: if true; // Public
      allow write: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}
