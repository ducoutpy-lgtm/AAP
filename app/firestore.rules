rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Règles du MVP « consultation publique fiable » (rapport de critique validé le 2026-10-14, lot 0,
    // instruction 8) : seules les collections aap et users sont actives ; les collections des modules gelés
    // sont en écriture interdite jusqu'au lot 4 (leurs lectures restent celles d'avant).

    // Fonctions d'aide
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasActiveSubscription() {
      return isAuthenticated() &&
             (userData().subscriptionStatus == 'active' || userData().subscriptionStatus == 'trial');
    }

    function isAdmin() {
      return isAuthenticated() && userData().userType == 'admin';
    }

    // Utilisateurs
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Création par le propriétaire seulement : le document naît avec le compte (l'inscription publique est fermée)
      allow create: if isOwner(userId);
      // Mise à jour : le propriétaire, ou l'administrateur (suspendre / activer écrit subscriptionStatus)
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // AAP (appels à projets)
    match /aap/{aapId} {
      // Lecture : un AAP publié est public (lisible sans compte) ; les autres statuts sont lisibles par
      // l'administrateur et par les comptes avec abonnement. Les requêtes de liste sans compte doivent
      // filtrer sur status == 'published'.
      allow read: if resource.data.status == 'published' || isAdmin() || hasActiveSubscription();

      // Écriture : administrateur seulement (publier, clôturer, archiver, supprimer). La création par un
      // financeur appartient au module gelé ; l'import des fiches passe par le SDK admin, hors de ces règles.
      allow create, update, delete: if isAdmin();
    }

    // Collections des modules gelés : lectures d'avant, aucune écriture

    match /porteurProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /financeurProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    match /applications/{applicationId} {
      allow read: if isAuthenticated() && (
        resource.data.porteurId == request.auth.uid ||
        resource.data.financeurId == request.auth.uid ||
        isAdmin()
      );
      allow write: if false;
    }

    match /savedSearches/{searchId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    match /favoriteAap/{favoriteId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId);
      allow write: if false;
    }

    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
