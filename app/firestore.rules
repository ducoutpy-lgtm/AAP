rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Règles de l'application complète (changement degel-application-complete du 2026-10-19, décision de Monsieur
    // DUCOUT). Elles reprennent les règles d'avant le lot 0 pour les collections des modules, en gardant les acquis du
    // lot 0 : lecture publique des appels publiés, administrateur seul à modifier un appel importé, document users
    // créé par son propriétaire. payments et analytics restent écrites par les fonctions serveur seulement.

    // Fonctions d'aide
    function isAuthenticated() {
      return request.auth != null;
    }

    // Champs de propriétaire inchangés par une mise à jour (relecture du 2026-11-17 : un compte ne transfère pas un
    // document à un autre compte)
    function figes(champs) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(champs);
    }

    // Champs écrits par l'évaluation du financeur (EvaluateApplicationPage)
    function champsEvaluation() {
      return ['financeurScore', 'financeurFeedback', 'evaluatedAt'];
    }

    // Statut d'un appel modifié par son auteur : inchangé, ou brouillon -> publié, ou publié -> clôturé
    function statutAuteurPermis() {
      let avant = resource.data.get('status', '');
      let apres = request.resource.data.get('status', '');
      return apres == avant || (avant == 'draft' && apres == 'published') || (avant == 'published' && apres == 'closed');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasActiveSubscription() {
      return isAuthenticated() &&
             (userData().subscriptionStatus == 'active' || userData().subscriptionStatus == 'trial');
    }

    function isAdmin() {
      return isAuthenticated() && userData().userType == 'admin';
    }

    // Rôles qu'un compte peut se donner lui-même (question 20, 2026-11-13) : jamais « admin »
    function roleOuvert(role) {
      return role in ['porteur', 'financeur'];
    }

    function isPorteur() {
      return isAuthenticated() && userData().userType == 'porteur';
    }

    function isFinanceur() {
      return isAuthenticated() && userData().userType == 'financeur';
    }

    // Utilisateurs
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Création par le propriétaire seulement : le document naît avec le compte, en porteur ou financeur, jamais en
      // administrateur (faille relevée le 2026-11-13, question 20 ; les administrateurs sont créés par
      // scripts/creer_admin.py, qui passe par la clé de service)
      allow create: if isOwner(userId) && roleOuvert(request.resource.data.get('userType', ''));
      // Mise à jour : l'administrateur ; le propriétaire sans toucher au rôle, sauf passage entre porteur et financeur
      // (parcours d'intégration)
      allow update: if isAdmin() || (isOwner(userId) && (
        request.resource.data.get('userType', '') == resource.data.get('userType', '') ||
        (roleOuvert(request.resource.data.get('userType', '')) && roleOuvert(resource.data.get('userType', '')))));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Profils
    // Messages du formulaire de contact (navigation-et-pages-publiques, 2026-10-20) : tout visiteur peut en créer un,
    // seul l'administrateur les lit. Règle écrite par la session, déploiement après accord de Monsieur DUCOUT.
    match /messagesContact/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['sujet', 'email', 'message', 'userId', 'createdAt'])
        && request.resource.data.message is string && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;
      allow read, update, delete: if isAdmin();
    }

    // Journal des actions des testeurs (suivi-testeurs, 2026-10-21) : un compte connecté écrit ses propres lignes,
    // seul l'administrateur lit ; rien ne se modifie ni ne se supprime depuis l'application. Déploiement après accord.
    match /journal/{ligneId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'role', 'action', 'cible', 'libelle', 'le']);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Retours des testeurs (mise-en-ligne-testeurs, 2026-10-21) : un compte connecté crée son propre retour avec les
    // seuls champs attendus ; l'administrateur lit ; personne ne modifie ni ne supprime
    match /retours/{retourId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'role', 'email', 'type', 'page', 'message', 'le'])
        && request.resource.data.message is string && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 4000;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Coûts des appels au modèle depuis les fonctions serveur (candidature-depuis-pdf, 2026-10-21) : le serveur écrit
    // avec le SDK admin (hors de ces règles), l'administrateur lit, personne d'autre
    match /coutsIa/{ligneId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /porteurProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    match /financeurProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // AAP (appels à projets)
    match /aap/{aapId} {
      // Lecture : un AAP publié est public (lisible sans compte) ; les autres statuts sont lisibles par
      // l'administrateur, par les comptes avec abonnement et par le financeur auteur. Les requêtes de liste sans
      // compte doivent filtrer sur status == 'published'.
      allow read: if resource.data.status == 'published' || isAdmin() || hasActiveSubscription()
        || (isAuthenticated() && resource.data.financeurId == request.auth.uid);

      // Création : un financeur abonné, pour son propre compte (financeurId = son identifiant). Les fiches
      // importées (financeurId 'scraped') passent par le SDK admin, hors de ces règles.
      // Ni verdict de relecture ni source autre que « manual » à la création (corrections-relecture 2.4, 2026-11-20).
      allow create: if isFinanceur() && hasActiveSubscription() && request.resource.data.financeurId == request.auth.uid
        && request.resource.data.get('source', 'manual') == 'manual'
        && !request.resource.data.keys().hasAny(['validation']);

      // Mise à jour et suppression : l'administrateur (publier, clôturer, archiver, supprimer, y compris les fiches
      // importées), ou le financeur auteur de l'appel. L'auteur ne touche ni au verdict de relecture ni à la source, et
      // ne change le statut que vers l'avant : brouillon -> publié -> clôturé ; un appel archivé ou clôturé par
      // l'administrateur ne revient pas dans la recherche par lui (corrections-relecture 2.4, 2026-11-20).
      allow update: if isAdmin() || (isAuthenticated() && resource.data.financeurId == request.auth.uid
        && figes(['financeurId', 'validation', 'source']) && statutAuteurPermis());
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.financeurId == request.auth.uid);
    }

    // Candidatures
    match /applications/{applicationId} {
      // Lecture : porteur propriétaire, financeur de l'AAP, administrateur
      allow read: if isAuthenticated() && (
        resource.data.porteurId == request.auth.uid ||
        resource.data.financeurId == request.auth.uid ||
        isAdmin()
      );

      // Création : un porteur abonné, pour son propre compte, en brouillon ou envoyée, sans évaluation, adressée au
      // financeur de l'appel (corrections-relecture 2.4, 2026-11-20 : une candidature pouvait naître « acceptée »)
      allow create: if isPorteur() && hasActiveSubscription() && request.resource.data.porteurId == request.auth.uid
        && request.resource.data.get('status', '') in ['draft', 'submitted']
        && !request.resource.data.keys().hasAny(champsEvaluation())
        && request.resource.data.financeurId == get(/databases/$(database)/documents/aap/$(request.resource.data.aapId)).data.financeurId;

      // Mise à jour : le porteur propriétaire tant que la candidature est en brouillon (sans se donner de décision), ou le
      // financeur, limité à l'évaluation : il ne réécrit plus le dossier du candidat (corrections-relecture 2.4)
      allow update: if isAuthenticated() && (
        (resource.data.porteurId == request.auth.uid && resource.data.status == 'draft' && figes(['porteurId', 'financeurId'])
          && request.resource.data.status in ['draft', 'submitted']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(champsEvaluation())) ||
        (resource.data.financeurId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(champsEvaluation().concat(['status', 'updatedAt']))) ||
        // Suppression du compte (question 25, 2026-11-19) : sur une candidature envoyée, le candidat ne peut que
        // remplacer son identifiant par « compte-supprime »
        (resource.data.porteurId == request.auth.uid && request.resource.data.porteurId == 'compte-supprime'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['porteurId']))
      );

      // Suppression : le porteur propriétaire, en brouillon, ou candidature à un appel importé (suivi tenu par lui seul ;
      // suppression du compte, question 25)
      allow delete: if isOwner(resource.data.porteurId) && (resource.data.status == 'draft' || resource.data.financeurId == 'scraped');
    }

    // Recherches sauvegardées et favoris : le propriétaire seulement (userId dans le document)
    // Propriétaire figé à la mise à jour (corrections-relecture-16-novembre) : une recherche réattribuée à un autre compte
    // ferait partir le lundi, depuis la boîte officielle, un nom choisi par l'auteur de la réattribution
    match /savedSearches/{searchId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow create: if isOwner(request.resource.data.userId);
    }

    match /favoriteAap/{favoriteId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow create: if isOwner(request.resource.data.userId);
    }

    // Notifications : le destinataire les lit, les marque lues et les supprime ; l'administrateur peut en créer.
    // Les notifications automatiques viennent des fonctions serveur (SDK admin), hors de ces règles.
    match /notifications/{notificationId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
    }

    // Messages : expéditeur et destinataire lisent ; un compte abonné écrit en son nom ; le destinataire marque lu
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if hasActiveSubscription() && request.resource.data.senderId == request.auth.uid;
      allow update: if isOwner(resource.data.receiverId) && figes(['senderId', 'receiverId']);
    }

    // Paiements et statistiques agrégées : écrits par les fonctions serveur seulement
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Chiffres publics de la page Financeurs (financeur-vendable, 2026-10-21) : un seul document, lisible sans compte,
    // écrit par scripts/publier_chiffres.py avec le SDK admin (hors de ces règles)
    match /statistiquesPubliques/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
