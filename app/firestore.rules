rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Règles de l'application complète (changement degel-application-complete du 2026-10-19, décision de Monsieur
    // DUCOUT). Elles reprennent les règles d'avant le lot 0 pour les collections des modules, en gardant les acquis du
    // lot 0 : lecture publique des appels publiés, administrateur seul à modifier un appel importé, document users
    // créé par son propriétaire. payments et analytics restent écrites par les fonctions serveur seulement.

    // Fonctions d'aide
    function isAuthenticated() {
      return request.auth != null;
    }

    // Champs de propriétaire inchangés par une mise à jour (relecture du 2026-11-17 : un compte ne transfère pas un
    // document à un autre compte)
    function figes(champs) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(champs);
    }

    // Champs écrits par l'évaluation du financeur (EvaluateApplicationPage)
    function champsEvaluation() {
      return ['financeurScore', 'financeurFeedback', 'evaluatedAt'];
    }

    // Bloc de validation écrit par un financeur : « Proposée », sans relecteur (plan niveau A, lot 1.2)
    function aValiderSansRelecteur() {
      return request.resource.data.get('validation', {}).get('statut', '') == 'proposee'
        && request.resource.data.get('validation', {}).get('par', '') == '';
    }

    // Appel visible du public (relecture du 2026-11-25, constats 2, 14 et 43) : validation absente (saisi à la main avant
    // le lot 1.2) ou « validee », comme visiblePubliquement (src/utils/relecture.ts) à l'écran
    function relectureVisible(appel) {
      return appel.get('validation', null) == null || appel.validation.get('statut', '') == 'validee';
    }

    function publieEtVisible(appel) {
      return appel.get('status', '') == 'published' && relectureVisible(appel);
    }

    // Appel lisible de tous (question 49, 2026-11-26) : publié ou clôturé, et visible, comme ficheConsultable
    // (src/utils/candidat.ts) à l'écran
    function lisibleDeTous(appel) {
      return appel.get('status', '') in ['published', 'closed'] && relectureVisible(appel);
    }

    // Appel auquel un candidat écrit une candidature : publié et visible, ou fiche importée clôturée mais visible pour le
    // seul suivi externe (relecture du 2026-11-25, remarque sur le constat 14 : ficheConsultable ouvre cette fiche et
    // le bouton « J'ai déposé ma candidature : la suivre ici » y reste affiché)
    function ouvertALaCandidature(appel) {
      return publieEtVisible(appel)
        || (appel.get('status', '') == 'closed' && appel.get('financeurId', '') == 'scraped' && relectureVisible(appel)
            && request.resource.data.get('externe', false) == true
            // Suivi envoyé d'emblée : un suivi en brouillon devenait ensuite un dossier ordinaire en retirant « externe »
            && request.resource.data.get('status', '') == 'submitted');
    }

    // Statut d'un appel modifié par son auteur : inchangé, ou brouillon -> publié, ou publié -> clôturé
    // Compteur de vues (décision 35 du 2026-11-24) : un compte connecté qui ouvre un appel publié ajoute exactement 1 à
    // `views`, sans toucher à aucun autre champ ; un appel publié encore « Proposée » ou « à corriger », fermé au
    // candidat, ne compte pas de vue (relecture du 2026-11-25).
    // Question 52 (« oui » de Monsieur DUCOUT, 2026-11-26) : une vue par compte et par appel. L'ajout n'est accepté
    // qu'avec la création, dans la même écriture, de la marque de vue du compte (`aap/{id}/vues/{uid}`), absente avant ;
    // une seconde ouverture trouve la marque et est refusée, le compteur ne change pas.
    function ajouteUneVue(aapId) {
      let marque = /databases/$(database)/documents/aap/$(aapId)/vues/$(request.auth.uid);
      return isAuthenticated() && publieEtVisible(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        && request.resource.data.views == resource.data.get('views', 0) + 1
        && !exists(marque) && existsAfter(marque)
        // Compte inscrit seulement (2026-11-27) : sans document users, effacer ses marques ne permet pas de recompter
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function statutAuteurPermis() {
      let avant = resource.data.get('status', '');
      let apres = request.resource.data.get('status', '');
      return apres == avant || (avant == 'draft' && apres == 'published') || (avant == 'published' && apres == 'closed');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasActiveSubscription() {
      return isAuthenticated() &&
             (userData().subscriptionStatus == 'active' || userData().subscriptionStatus == 'trial');
    }

    function isAdmin() {
      return isAuthenticated() && userData().userType == 'admin';
    }

    // Rôles qu'un compte peut se donner lui-même (question 20, 2026-11-13) : jamais « admin »
    function roleOuvert(role) {
      return role in ['porteur', 'financeur'];
    }

    function isPorteur() {
      return isAuthenticated() && userData().userType == 'porteur';
    }

    function isFinanceur() {
      return isAuthenticated() && userData().userType == 'financeur';
    }

    // Compte suspendu (question 51, décision « Registre des suspensions » de Monsieur DUCOUT du 2026-11-26) : une fiche
    // existe à son identifiant ou à son adresse de connexion. Une règle ne fait pas de requête (pas de « where email ==
    // ... ») : elle ne lit un document que par son chemin exact. L'adresse est donc dans l'identifiant de la seconde fiche,
    // suspensions/email:<adresse en minuscules>, écrite avec la première par ManageUsersPage. Le préfixe « email: » la
    // sépare des identifiants de compte dans la même collection, gardée par une seule règle. Minuscules des deux côtés :
    // l'adresse saisie à l'inscription peut différer en casse de celle du compte suspendu.
    function estSuspendu() {
      return exists(/databases/$(database)/documents/suspensions/$(request.auth.uid))
        || exists(/databases/$(database)/documents/suspensions/$('email:' + request.auth.token.get('email', '').lower()));
    }

    // Utilisateurs
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Création par le propriétaire seulement : le document naît avec le compte, en porteur ou financeur, jamais en
      // administrateur (faille relevée le 2026-11-13, question 20 ; les administrateurs sont créés par
      // scripts/creer_admin.py, qui passe par la clé de service)
      // Le compte naît en essai, jamais abonné (plan niveau A, lot 1, 2026-11-24)
      // Ni par un compte suspendu (question 51, 2026-11-26) : il supprimait son document puis le recréait en essai, ou
      // ouvrait un nouveau compte avec la même adresse
      // Le champ email est l'adresse de connexion (contre-vérification du 2026-11-26) : ManageUsersPage écrit la fiche
      // suspensions/email:<adresse> d'après ce champ ; une adresse leurre la mettait sur une autre adresse que celle du
      // compte. Deux valeurs absentes sont égales : un compte sans adresse (compte de test) écrit un document sans adresse
      allow create: if isOwner(userId) && roleOuvert(request.resource.data.get('userType', ''))
        && request.resource.data.get('subscriptionStatus', 'trial') == 'trial'
        && request.resource.data.get('email', null) == request.auth.token.get('email', null) && !estSuspendu();
      // Mise à jour : l'administrateur ; le propriétaire seulement sur ses champs de parcours (plan niveau A, lot 1 : il
      // réécrivait son adresse, lue par le courriel du lundi, et pouvait se donner un abonnement ou prolonger son essai),
      // sans toucher au rôle, sauf passage entre porteur et financeur (parcours d'intégration)
      allow update: if isAdmin() || (isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['demarrage', 'profileComplete', 'cguAccepteLe', 'userType', 'notificationPreferences'])
        && (request.resource.data.get('userType', '') == resource.data.get('userType', '') ||
            (roleOuvert(request.resource.data.get('userType', '')) && roleOuvert(resource.data.get('userType', '')))));
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Registre des suspensions (question 51, 2026-11-26) : suspensions/{uid} et suspensions/email:<adresse>, écrites et
    // effacées par l'administrateur depuis ManageUsersPage ; le compte suspendu ne les lit ni ne les efface
    match /suspensions/{ficheId} {
      allow read, write: if isAdmin();
    }

    // Profils
    // Messages du formulaire de contact (navigation-et-pages-publiques, 2026-10-20) : tout visiteur peut en créer un,
    // seul l'administrateur les lit. Règle écrite par la session, déploiement après accord de Monsieur DUCOUT.
    match /messagesContact/{messageId} {
      // Champs bornés (plan niveau A, lot 1.3, 2026-11-24) : sujet de la liste, adresse de 254 caractères au plus, compte
      // vide ou celui de l'expéditeur. Le nombre d'envois par visiteur ne se borne pas par une règle Firestore.
      allow create: if request.resource.data.keys().hasOnly(['sujet', 'email', 'message', 'userId', 'createdAt'])
        && request.resource.data.message is string && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.get('sujet', '') in ['question', 'offres', 'fiche', 'source', 'compte', 'autre']
        && (request.resource.data.get('email', null) == null
            || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
        && (request.resource.data.get('userId', null) == null
            || (isAuthenticated() && request.resource.data.userId == request.auth.uid));
      allow read, update, delete: if isAdmin();
    }

    // Journal des actions des testeurs (suivi-testeurs, 2026-10-21) : un compte connecté écrit ses propres lignes,
    // seul l'administrateur lit ; rien ne se modifie ni ne se supprime depuis l'application. Déploiement après accord.
    match /journal/{ligneId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'role', 'action', 'cible', 'libelle', 'le']);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Retours des testeurs (mise-en-ligne-testeurs, 2026-10-21) : un compte connecté crée son propre retour avec les
    // seuls champs attendus ; l'administrateur lit ; personne ne modifie ni ne supprime
    match /retours/{retourId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'role', 'email', 'type', 'page', 'message', 'le'])
        && request.resource.data.message is string && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 4000;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Coûts des appels au modèle depuis les fonctions serveur (candidature-depuis-pdf, 2026-10-21) : le serveur écrit
    // avec le SDK admin (hors de ces règles), l'administrateur lit, personne d'autre
    match /coutsIa/{ligneId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /porteurProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    match /financeurProfiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);
    }

    // AAP (appels à projets)
    match /aap/{aapId} {
      // Lecture : un AAP publié ou clôturé et visible est public (lisible sans compte) ; tout autre appel (brouillon,
      // archivé ou rejeté, publié encore « Proposée » ou « à corriger ») n'est lisible que par l'administrateur et le
      // financeur auteur. Question 49 (décision « maintenant » de Monsieur DUCOUT, 2026-11-26) : tout compte en essai
      // lisait par le kit Firebase les appels non publiés, un visiteur un appel publié encore « Proposée ».
      allow get: if lisibleDeTous(resource.data) || isAdmin()
        || (isAuthenticated() && resource.data.financeurId == request.auth.uid);
      // Requêtes de liste : Firestore ne filtre pas, il prouve la règle par les contraintes de la requête. Un get() avec
      // valeur par défaut sur un champ que la requête ne contraint pas rend cette valeur (constaté sur l'émulateur le
      // 2026-11-26 : avec relectureVisible, « status == 'published' » seule renvoyait à un visiteur un appel « Proposée »).
      // La liste lit donc le bloc de validation sans valeur par défaut : les pages d'un candidat, d'un visiteur ou d'un
      // financeur hors ses appels filtrent sur status == 'published' ET validation.statut == 'validee'. Un appel publié
      // sans bloc de validation reste lisible par son adresse mais ne sort pas de ces listes
      // (scripts/valider_publiees_sans_bloc.py lui ajoute le bloc).
      allow list: if (resource.data.status in ['published', 'closed'] && resource.data.validation.statut == 'validee')
        || isAdmin() || (isAuthenticated() && resource.data.financeurId == request.auth.uid);

      // Création : un financeur abonné, pour son propre compte (financeurId = son identifiant). Les fiches
      // importées (financeurId 'scraped') passent par le SDK admin, hors de ces règles.
      // Ni verdict de relecture ni source autre que « manual » à la création (corrections-relecture 2.4, 2026-11-20).
      // Plan niveau A, lot 1.2 (décision « Validation admin » du 2026-11-24) : l'appel naît « Proposée », sans relecteur,
      // et ne paraît qu'après validation par l'administrateur (visiblePubliquement)
      // Relecture du 2026-11-25 (constat 6) : source « manual » obligatoire, comme l'écrit aapService.createAap, et pas de
      // bloc scrapeMetadata, réservé à l'import (le tri y lit le contrôle du modèle, l'écran la thématique)
      // Question 52, relecture du 2026-11-26 : l'appel naît sans vue (le financeur fixait lui-même son compteur)
      allow create: if isFinanceur() && hasActiveSubscription() && request.resource.data.financeurId == request.auth.uid
        && request.resource.data.get('source', '') == 'manual' && aValiderSansRelecteur()
        && !request.resource.data.keys().hasAny(['scrapeMetadata']) && request.resource.data.get('views', 0) == 0;

      // Mise à jour et suppression : l'administrateur (publier, clôturer, archiver, supprimer, y compris les fiches
      // importées), ou le financeur auteur de l'appel. L'auteur ne touche ni au verdict de relecture ni à la source, et
      // ne change le statut que vers l'avant : brouillon -> publié -> clôturé ; un appel archivé ou clôturé par
      // l'administrateur ne revient pas dans la recherche par lui (corrections-relecture 2.4, 2026-11-20).
      // Plan niveau A, lot 1.2 : toute modification par l'auteur repasse l'appel « Proposée » (une fois validé, il pouvait
      // le réécrire sans nouveau contrôle) ; seule la clôture d'un appel publié se fait telle quelle.
      // L'auteur ne touche pas non plus au bloc scrapeMetadata, réservé à l'import (relecture du 2026-11-25, constat 6),
      // ni au compteur de vues, qui ne monte qu'avec une marque de vue (question 52, relecture du 2026-11-26).
      allow update: if isAdmin() || ajouteUneVue(aapId) || (isAuthenticated() && resource.data.financeurId == request.auth.uid
        && figes(['financeurId', 'source', 'scrapeMetadata', 'views']) && statutAuteurPermis()
        && (aValiderSansRelecteur() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
                                        && request.resource.data.status == 'closed')));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.financeurId == request.auth.uid);

      // Marque de vue (question 52) : créée une seule fois par le compte lui-même, avec la date du serveur pour seul
      // champ, et seulement si la même écriture ajoute une vue à l'appel (sinon une marque isolée, ou posée sur un
      // appel inexistant ou fermé, serait acceptée). Jamais lue, réécrite ni effacée depuis l'application : elle ne
      // sert qu'au contrôle de la règle ci-dessus (donnée minimale : identifiant du compte et date d'ouverture).
      // Décision « Effacer avec le compte » (2026-11-27, RGPD) : la marque porte aussi l'identifiant du compte, pour
      // qu'il retrouve ses marques ; il ne les efface qu'une fois son document users effacé (« Supprimer mon compte »),
      // jamais avant : il pourrait sinon recompter sa vue.
      match /vues/{uid} {
        allow delete: if isOwner(uid) && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
        allow create: if isOwner(uid) && request.resource.data.keys().hasOnly(['vueLe', 'uid'])
          && request.resource.data.uid == uid && request.resource.data.vueLe == request.time
          && getAfter(/databases/$(database)/documents/aap/$(aapId)).data.get('views', 0)
             == get(/databases/$(database)/documents/aap/$(aapId)).data.get('views', 0) + 1;
      }
    }

    // Marques de vue d'un compte, lues par lui seul (requête de groupe sur `vues` filtrée sur son identifiant) pour
    // les effacer avec son compte (décision du 2026-11-27)
    match /{chemin=**}/vues/{uid} {
      allow list: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Candidatures
    match /applications/{applicationId} {
      // Lecture : porteur propriétaire, financeur de l'AAP, administrateur
      allow read: if isAuthenticated() && (
        resource.data.porteurId == request.auth.uid ||
        resource.data.financeurId == request.auth.uid ||
        isAdmin()
      );

      // Création : un porteur abonné, pour son propre compte, en brouillon ou envoyée, sans évaluation, adressée au
      // financeur de l'appel (corrections-relecture 2.4, 2026-11-20 : une candidature pouvait naître « acceptée »), et
      // seulement à un appel publié et visible, comme candidatureOuverte à l'écran (relecture du 2026-11-25, constat 14 :
      // par le SDK, un candidat écrivait à un brouillon, à un appel « Proposée » ou archivé) ; sur une fiche importée
      // clôturée et visible, le seul suivi externe (ouvertALaCandidature)
      allow create: if isPorteur() && hasActiveSubscription() && request.resource.data.porteurId == request.auth.uid
        && request.resource.data.get('status', '') in ['draft', 'submitted']
        && !request.resource.data.keys().hasAny(champsEvaluation())
        && ouvertALaCandidature(get(/databases/$(database)/documents/aap/$(request.resource.data.aapId)).data)
        && request.resource.data.financeurId == get(/databases/$(database)/documents/aap/$(request.resource.data.aapId)).data.financeurId;

      // Mise à jour : le porteur propriétaire tant que la candidature est en brouillon (sans se donner de décision), ou le
      // financeur, limité à l'évaluation : il ne réécrit plus le dossier du candidat (corrections-relecture 2.4)
      allow update: if isAuthenticated() && (
        (resource.data.porteurId == request.auth.uid && resource.data.status == 'draft' && figes(['porteurId', 'financeurId'])
          && request.resource.data.status in ['draft', 'submitted']
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(champsEvaluation())) ||
        (resource.data.financeurId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(champsEvaluation().concat(['status', 'updatedAt']))) ||
        // Suppression du compte (question 25, 2026-11-19) : sur une candidature envoyée, le candidat ne peut que
        // remplacer son identifiant par « compte-supprime »
        (resource.data.porteurId == request.auth.uid && request.resource.data.porteurId == 'compte-supprime'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['porteurId']))
      );

      // Suppression : le porteur propriétaire, en brouillon, ou candidature à un appel importé (suivi tenu par lui seul ;
      // suppression du compte, question 25)
      allow delete: if isOwner(resource.data.porteurId) && (resource.data.status == 'draft' || resource.data.financeurId == 'scraped');
    }

    // Recherches sauvegardées et favoris : le propriétaire seulement (userId dans le document)
    // Propriétaire figé à la mise à jour (corrections-relecture-16-novembre) : une recherche réattribuée à un autre compte
    // ferait partir le lundi, depuis la boîte officielle, un nom choisi par l'auteur de la réattribution
    match /savedSearches/{searchId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow create: if isOwner(request.resource.data.userId);
    }

    // Identifiant « compte_appel » imposé à la création, comme l'écrit favorisService (relecture du 2026-11-25,
    // constat 11) : un autre compte occupait d'avance le document et bloquait le favori
    match /favoriteAap/{favoriteId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow create: if isOwner(request.resource.data.userId)
        && favoriteId == request.auth.uid + '_' + request.resource.data.aapId;
    }

    // Notifications : le destinataire les lit, les marque lues et les supprime ; l'administrateur peut en créer.
    // Les notifications automatiques viennent des fonctions serveur (SDK admin), hors de ces règles.
    match /notifications/{notificationId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId) && request.resource.data.userId == resource.data.userId;
      allow create: if isOwner(request.resource.data.userId) || isAdmin();
    }

    // Messagerie (question 50, « construire » de Monsieur DUCOUT, 2026-11-26) : la page Messages lisait une collection
    // que rien n'écrivait. Une conversation par candidature envoyée par l'application (identifiant = celui de la
    // candidature), entre ses deux seuls participants : le candidat et le financeur de la candidature.
    function participantDe(conversation) {
      return isAuthenticated() && request.auth.uid in conversation.participants;
    }

    function conversationValide(applicationId) {
      let candidature = get(/databases/$(database)/documents/applications/$(applicationId)).data;
      let c = request.resource.data;
      return c.keys().hasOnly(['participants', 'applicationId', 'titre', 'appel', 'lastMessage', 'lastMessageAt', 'nonLuPar'])
        && c.applicationId == applicationId
        && c.participants == [candidature.porteurId, candidature.financeurId]
        && request.auth.uid in c.participants
        // Relecture du 2026-11-27 : pas de participant fantôme (fiche importée, compte supprimé, financeur absent)
        && candidature.financeurId is string && candidature.financeurId.size() > 0
        && candidature.financeurId != 'scraped' && candidature.porteurId != 'compte-supprime'
        // Candidature envoyée par l'application : ni brouillon, ni suivi d'un dépôt fait sur le site du financeur
        && candidature.get('status', 'draft') != 'draft' && candidature.get('externe', false) != true
        && c.titre is string && c.titre.size() <= 300 && c.appel is string && c.appel.size() <= 300
        && c.lastMessage == '' && c.nonLuPar == null
        // Date du serveur seulement (relecture du 2026-11-27 : une valeur choisie bloquait la page de l'autre)
        && c.lastMessageAt == request.time;
    }

    match /conversations/{applicationId} {
      // Une conversation absente se constate (l'application regarde avant de la créer) ; l'identifiant est celui de
      // la candidature, rien d'autre n'est révélé
      allow get: if resource == null || participantDe(resource.data);
      allow list: if participantDe(resource.data);
      // Compte actif seulement (relecture du 2026-11-27 : un compte suspendu ou expiré gardait ce canal d'écriture)
      allow create: if hasActiveSubscription() && conversationValide(applicationId);
      // Un participant met à jour l'aperçu du dernier message (200 caractères au plus), sa date (celle du serveur), et
      // la marque « non lu » (posée pour l'autre participant à l'envoi, effacée à la lecture) ; jamais les
      // participants. Effacer sa marque « non lu » reste permis à un compte suspendu ; le reste exige un compte actif.
      allow update: if participantDe(resource.data) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nonLuPar']) && request.resource.data.nonLuPar == null)
        || (hasActiveSubscription()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt', 'nonLuPar'])
            && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 200
            && (request.resource.data.nonLuPar == null || request.resource.data.nonLuPar in resource.data.participants)
            && (!('lastMessageAt' in request.resource.data.diff(resource.data).affectedKeys())
                || request.resource.data.lastMessageAt == request.time)));
    }

    // Un message : écrit par son expéditeur connecté, adressé à l'autre participant de sa conversation, de 1 à 5 000
    // caractères, à la date du serveur, non lu (question 50)
    function messageValide() {
      let m = request.resource.data;
      let conversation = get(/databases/$(database)/documents/conversations/$(m.conversationId)).data;
      return m.keys().hasOnly(['conversationId', 'senderId', 'receiverId', 'content', 'createdAt', 'read'])
        && m.senderId == request.auth.uid && request.auth.uid in conversation.participants
        && m.receiverId in conversation.participants && m.receiverId != m.senderId
        && m.content is string && m.content.size() >= 1 && m.content.size() <= 5000
        && m.createdAt == request.time && m.read == false;
    }

    // Messages : expéditeur et destinataire lisent ; un compte abonné écrit en son nom ; le destinataire marque lu
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if hasActiveSubscription() && messageValide();
      // Le destinataire ne fait que marquer le message lu (plan niveau A, lot 1.3 : il pouvait en réécrire le contenu)
      allow update: if isOwner(resource.data.receiverId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
    }

    // Paiements et statistiques agrégées : écrits par les fonctions serveur seulement
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if false;
    }

    match /analytics/{analyticsId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Chiffres publics de la page Financeurs (financeur-vendable, 2026-10-21) : un seul document, lisible sans compte,
    // écrit par scripts/publier_chiffres.py avec le SDK admin (hors de ces règles)
    match /statistiquesPubliques/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
