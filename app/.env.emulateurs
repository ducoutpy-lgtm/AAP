# Mode « emulateurs » de l'application (changement emulateurs-parcours-connectes, 2026-10-20) : Vite charge ce fichier
# avec « npm run dev:emulateurs » (--mode emulateurs). Aucun secret : le projet demo-aap n'existe que sur ce PC, dans
# les emulateurs Firebase (comptes, base, stockage). Les valeurs ci-dessous remplacent celles de .env pour ce mode.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-aap-cle-factice
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=demo-aap
VITE_FIREBASE_STORAGE_BUCKET=demo-aap.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-aap
VITE_STRIPE_PUBLIC_KEY=pk_test_factice
VITE_APP_ENV=emulateurs
VITE_APP_URL=http://localhost:3001
