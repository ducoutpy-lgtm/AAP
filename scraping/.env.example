# Copier ce fichier en .env et renseigner votre cle Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Recherche web (changement registre-par-annuaires) : cle Tavily, 1 000 credits par mois sans carte, a creer sur tavily.com
TAVILY_API_KEY=

# Boite d'envoi des courriels hebdomadaires (changement alertes-courriel, 2026-10-20) : Zoho Mail d'ARCADIA, avec un
# mot de passe d'application (Zoho : Securite > Mots de passe d'application), jamais le mot de passe du compte.
# Sans ces variables, les courriels sont ecrits dans logs/courriels/ au lieu d'etre envoyes.
SMTP_HOTE=smtp.zoho.eu
SMTP_PORT=465
SMTP_UTILISATEUR=adresse@domaine.fr
SMTP_MOT_DE_PASSE=
COURRIEL_EXPEDITEUR=adresse@domaine.fr
COURRIEL_ADMIN=adresse-qui-recoit-le-bilan@domaine.fr
